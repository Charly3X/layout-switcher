# Maintainer: Charly3X <953456+Charly3X@users.noreply.github.com>
pkgname=plasma-layout-switcher
_name=layout-switcher
pkgver=0.1.1
pkgrel=1
pkgdesc="Punto Switcher-style wrong keyboard layout fixer (English/Russian) for KDE Plasma on Wayland"
arch=('any')
url="https://github.com/Charly3X/$_name"
license=('MIT')
depends=('python' 'python-pyqt6' 'aspell' 'aspell-en' 'aspell-ru' 'systemd')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
# Another AUR package also installs /usr/bin/layout-switcher.
conflicts=('layout-switcher' 'layout-switcher-git')
install=$pkgname.install
source=("$_name-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('9269f229c34fc23709dea94606839a291001e662990cc4c50ff7f8017f404a3e')

build() {
  cd "$_name-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$_name-$pkgver"
  python -m unittest discover -s tests -t .
}

package() {
  cd "$_name-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$_name.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Layout Switcher
Comment=Fixes words typed in the wrong keyboard layout
Exec=layout-switcher
Icon=input-keyboard
Terminal=false
Categories=Utility;
EOF

  # Opt-in: only users the admin adds to the input group may create the virtual keyboard.
  # They need that group anyway to read the keyboard, so this adds no new kind of access;
  # uaccess would instead hand keystroke injection to every local user.
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/udev/rules.d/60-$pkgname-uinput.rules" <<EOF
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
EOF
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/modules-load.d/$pkgname.conf" <<EOF
uinput
EOF
}
